# GitHub Integration Configuration
# Copiar este archivo a .env.local y llenar con valores reales

# ============================================
# GitHub Personal Access Token (REQUERIDO)
# ============================================
# Obtener en: https://github.com/settings/tokens
# Scopes necesarios: repo, gist, user:email
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================
# GitHub Personal Access Token - Servidor
# (OPCIONAL - Para servidor backend)
# ============================================
GITHUB_TOKEN_SERVER=ghp_yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy

# ============================================
# Webhook Configuration (OPCIONAL)
# ============================================
# Secreto para validar webhooks de GitHub
WEBHOOK_SECRET=tu_webhook_secreto_aleatorio

# URL base para recibir webhooks
# Ejemplo: https://drawdb-server.example.com/api
WEBHOOK_BASE_URL=http://localhost:3001/api

# ============================================
# Slack Integration (OPCIONAL)
# ============================================
# Webhook para alertas en Slack
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# ============================================
# Application Configuration
# ============================================
# Ambiente: development, staging, production
NODE_ENV=development

# Puerto del servidor
PORT=3001

# ============================================
# Database Configuration (SI APLICA)
# ============================================
# DATABASE_URL=postgresql://user:password@localhost:5432/drawdb

# ============================================
# Analytics (OPCIONAL)
# ============================================
# VERCEL_ANALYTICS_ID=tu_analytics_id

# ============================================
# NOTAS IMPORTANTES
# ============================================
# 1. NO comitear .env con valores reales en Git
# 2. Usar .env.local para desarrollo local
# 3. Configurar variables en CI/CD (GitHub Actions, etc)
# 4. Mantener secretos seguros
# 5. Rotar tokens regularmente
#
# Para crear un Personal Access Token:
# 1. Ir a https://github.com/settings/tokens
# 2. Click "Generate new token" > "Generate new token (classic)"
# 3. Seleccionar scopes: repo, gist, user:email
# 4. Copiar token y asignar a GITHUB_TOKEN
